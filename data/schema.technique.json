{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alertforge.dev/schema/technique/v1.json",
  "title": "AlertForge Technique",
  "type": "object",
  "required": ["schemaVersion", "id", "slug", "title", "category", "attack", "artifact", "detection", "falsePositives", "mitigation"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^T\\d{4}(\\.\\d{3})?$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 2, "maxLength": 120 },
    "category": { "enum": ["wireless", "active-directory", "web", "host", "network", "cloud"] },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"], "default": "intermediate" },
    "orgId": { "type": ["string", "null"], "default": null },
    "attack": {
      "type": "object",
      "required": ["tactic", "tacticId", "attackUrl", "summary"],
      "additionalProperties": false,
      "properties": {
        "tactic": { "type": "string" },
        "tacticId": { "type": "string", "pattern": "^TA\\d{4}$" },
        "attackUrl": { "type": "string", "format": "uri" },
        "summary": { "type": "string", "minLength": 20, "maxLength": 1200 },
        "representativeCommand": { "type": "string" },
        "commandNote": { "type": "string", "default": "Illustrative / lab-only." }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["source", "keyFields"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "primaryEvent": { "type": "string" },
        "keyFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "whyItMatters"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "value": { "type": "string" },
              "whyItMatters": { "type": "string" }
            }
          }
        },
        "sampleLogLine": { "type": "string" }
      }
    },
    "detection": {
      "type": "object",
      "required": ["format", "rule", "annotations"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["sigma", "yara", "suricata", "kql", "spl", "eql"] },
        "ruleTitle": { "type": "string" },
        "source": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "rule": { "type": "string" },
        "annotations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["line", "explain"],
            "additionalProperties": false,
            "properties": {
              "line": { "type": "string" },
              "explain": { "type": "string" }
            }
          }
        }
      }
    },
    "falsePositives": { "type": "array", "items": { "type": "string" } },
    "mitigation": {
      "type": "object",
      "required": ["summary", "controls"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "controls": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "attackDefendRef": { "type": "string" }
      }
    },
    "relatedSlugs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
